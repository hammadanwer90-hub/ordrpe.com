{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "shoppish.pk" }],
      "destination": "https://www.shoppish.pk/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/calculator",
      "destination": "/calculator.html"
    },
    {
      "source": "/membership",
      "destination": "/membership.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/agreement",
      "destination": "/agreement.html"
    }
  ]
}
